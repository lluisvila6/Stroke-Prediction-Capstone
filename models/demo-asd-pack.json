{
  "schemaVersion": "1.0",
  "pack": {
    "id": "demo-asd-structural",
    "name": "ASD structural demonstration",
    "version": "0.1.0",
    "population": "Adult spinal deformity, primary or revision, instrumented posterior fusion of 4 or more levels",
    "validationStatus": "demonstration",
    "authors": "Placeholder — replace with your own pack",
    "institution": "—",
    "citation": "No citation. Coefficients are invented to demonstrate the file format.",
    "lastUpdated": "2026-09-02",
    "notes": "Every number in this pack is a placeholder. It exists so the console has something to run before your own models are loaded, and so you can see how each transform is encoded."
  },
  "report": {
    "intro": "Your surgeon has used a computer tool to estimate what spinal deformity surgery is likely to do for you. The estimates come from what happened to large groups of patients whose situation resembled yours. They describe groups, not individuals — nobody can tell you exactly what will happen to you.",
    "naturalHistory": "This report describes what may happen if you have the operation. It does not describe what happens if you do not. Your surgeon will talk to you separately about how your symptoms are likely to change without surgery, and about non-surgical treatments.",
    "questions": [
      "Which of these numbers matters most in my case, and why?",
      "How many operations like mine do you do in a year?",
      "What would you expect my recovery to look like in the first three months?",
      "If a complication happened, what would treating it involve?",
      "What happens to me if I decide not to have surgery, or to wait?",
      "Is there anything I should do before surgery to improve these numbers?"
    ],
    "closing": "You do not have to decide today. Take this report home, read it again, and bring your questions to your next appointment."
  },
