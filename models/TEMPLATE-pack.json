{
  "schemaVersion": "1.0",
  "pack": {
    "id": "essg-asd",
    "name": "",
    "version": "0.1.0",
    "population": "",
    "validationStatus": "internally-validated",
    "authors": "",
    "institution": "",
    "citation": "",
    "lastUpdated": "",
    "notes": ""
  },
  "report": {
    "intro": "Your surgeon has used a computer tool to estimate what this operation is likely to do for you. The estimates come from what happened to large groups of patients whose situation resembled yours. They describe groups, not individuals.",
    "naturalHistory": "",
    "questions": [
      "Which of these numbers matters most in my case, and why?",
      "What happens to me if I decide not to have surgery, or to wait?",
      "Is there anything I should do before surgery to improve these numbers?"
    ],
    "closing": "You do not have to decide today."
  },
  "variableGroups": [
    { "id": "demographics", "label": "Demographics" },
    { "id": "radiographic", "label": "Radiographic alignment" },
    { "id": "plan", "label": "Planned operation" }
  ],
  "variables": [
    { "id": "age", "label": "Age", "type": "number", "unit": "years", "group": "demographics", "min": 18, "max": 95, "decimals": 0, "derivationRange": [21, 84] },
    { "id": "sex", "label": "Sex", "type": "categorical", "group": "demographics", "options": [{ "value": "female", "label": "Female" }, { "value": "male", "label": "Male" }] },
    { "id": "smoking", "label": "Smoking", "type": "categorical", "group": "demographics", "modifiable": "patient", "optimized": "never", "options": [{ "value": "never", "label": "Never" }, { "value": "former", "label": "Former" }, { "value": "current", "label": "Current" }] },
    { "id": "pi", "label": "Pelvic incidence", "type": "number", "unit": "°", "group": "radiographic", "min": 20, "max": 95, "decimals": 0 },
    { "id": "ll", "label": "Lumbar lordosis L1–S1", "type": "number", "unit": "°", "group": "radiographic", "min": -20, "max": 100, "decimals": 0 },
    { "id": "revision", "label": "Revision surgery", "type": "boolean", "group": "plan" },
    { "id": "levels_fused", "label": "Levels instrumented", "type": "number", "unit": "levels", "group": "plan", "min": 2, "max": 20, "decimals": 0, "derivationRange": [4, 17], "modifiable": "plan", "optimized": 6 }
  ],
  "derived": [
    { "id": "pi_ll", "label": "PI − LL mismatch", "unit": "°", "group": "radiographic", "expression": "pi - ll", "decimals": 0 }
  ],
  "mcid": {},
  "models": [
    {
      "id": "example_binary",
      "label": "",
      "shortLabel": "",
      "kind": "risk",
      "type": "logistic",
      "timepoint": "90 days after surgery",
      "baselineRate": 0.15,
      "intercept": 0.0,
      "terms": [
        { "var": "age", "transform": "center", "center": 60, "coef": 0.0, "label": "Age" },
        { "var": "smoking", "transform": "level", "level": "current", "coef": 0.0, "label": "Current smoker" },
        { "var": "pi_ll", "transform": "identity", "coef": 0.0, "label": "PI − LL mismatch" },
        { "var": "revision", "transform": "identity", "coef": 0.0, "label": "Revision surgery" }
      ],
      "performance": { "auc": null, "calibrationSlope": null, "brier": null, "n": null, "events": null, "validation": "" },
      "patient": { "title": "", "positive": "", "negative": "", "explain": "" }
    },
    {
      "id": "example_continuous",
      "label": "",
      "shortLabel": "",
      "kind": "benefit",
      "type": "linear",
      "timepoint": "2 years after surgery",
      "unit": "ODI points",
      "lowerIsBetter": true,
      "sigma": 12.0,
      "intercept": 0.0,
      "terms": [
        { "var": "age", "transform": "center", "center": 60, "coef": 0.0, "label": "Age" }
      ],
      "thresholds": [{ "label": "ODI 20 or below", "op": "<=", "value": 20 }],
      "performance": { "r2": null, "rmse": null, "n": null, "validation": "" },
      "patient": { "title": "", "explain": "" }
    },
    {
      "id": "example_timetoevent",
      "label": "",
      "shortLabel": "",
      "kind": "risk",
      "type": "cox",
      "timepoint": "2 years after surgery",
      "horizonMonths": 24,
      "baselineRate": 0.2,
      "lpMean": 0.0,
      "baselineSurvival": [{ "t": 12, "s0": 0.9 }, { "t": 24, "s0": 0.82 }],
      "terms": [
        { "var": "revision", "transform": "identity", "coef": 0.0, "label": "Revision surgery" }
      ],
      "performance": { "cIndex": null, "n": null, "events": null, "validation": "" },
      "patient": { "title": "", "positive": "", "negative": "", "explain": "" }
    }
  ],
  "exampleCase": {}
}
